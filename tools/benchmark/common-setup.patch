+    private static void verifySelected(ReactorQL query, Map<String, Object>[] input, int[] indexes,
+                                       java.util.function.Function<Map<String, Object>, Map<String, Object>> oracle,
+                                       String scenario) {
+        AtomicInteger subscriptions = new AtomicInteger();
+        AtomicInteger position = new AtomicInteger();
+        Long count = query.start(Flux.defer(() -> {
+            subscriptions.incrementAndGet();
+            return Flux.fromArray(input);
+        })).doOnNext(actual -> {
+            int current = position.getAndIncrement();
+            if (current >= indexes.length) throw new IllegalStateException(scenario + " extra row");
+            Map<String, Object> expected = oracle.apply(input[indexes[current]]);
+            if (!actual.keySet().equals(expected.keySet())) throw new IllegalStateException(scenario + " fields at " + current);
+            for (String column : expected.keySet()) {
+                Object value = actual.get(column), reference = expected.get(column);
+                if (reference == null ? value != null : value == null || reference.getClass() != value.getClass() || !reference.equals(value)) {
+                    throw new IllegalStateException(scenario + " row=" + current + " column=" + column + " actual=" + value + " expected=" + reference);
+                }
+            }
+        }).count().block();
+        if (subscriptions.get() != 1 || count == null || count != indexes.length || position.get() != indexes.length) {
+            throw new IllegalStateException(scenario + " source/count/termination");
